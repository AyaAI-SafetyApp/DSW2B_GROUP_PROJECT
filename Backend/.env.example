# Resend Email Service Configuration
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender email (must be verified in Resend dashboard)
# Format: "Display Name <email@yourdomain.com>"
FROM_EMAIL=Aya Safety App <noreply@ayaapp.com>

# Note: For development, you can use Resend's test mode
# Test emails will appear in your Resend dashboard but won't be delivered
