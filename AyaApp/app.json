{
  "expo": {
    "name": "Welcome to Aya",
    "slug": "AyaAI",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Logos/Aya_Logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Logos/Aya_Logo.png"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to record your voice input."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logos/Aya_Logo.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/Logos/Aya_Logo.png"
    },
    "plugins": [
      "expo-av",
      "react-native-video",
      "expo-web-browser"
    ]
  }
}
